---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import { CALENDLY_URL } from "../lib/site";
import { baseGraph, breadcrumbNode, webPageNode } from "../lib/schema";

const title = "Get a Free Quote | Infused Agency";
const description =
  "Get a free, no-obligation quote for expert web design and SEO services in Niagara. Boost your online presence with Infused Agency's tailored solutions for local businesses. Request your custom quote today!";
const jsonLd = [
  ...baseGraph(),
  webPageNode({
    url: "/get-a-quote",
    name: title,
    description,
    type: "ContactPage",
  }),
  breadcrumbNode(
    [{ name: "Home", href: "/" }, { name: "Get a Quote" }],
    "/get-a-quote"
  ),
];
---

<BaseLayout title={title} description={description} canonical="/get-a-quote" jsonLd={jsonLd}>
  <PageHero
    title="Get Your Free Quote"
    description="Book your free project consultation directly in the calendar below — pick a time that works for you."
    breadcrumbs={[{ name: "Home", href: "/" }, { name: "Get a Quote" }]}
    eyebrow="Start a project"
    showCta={false}
  />

  <Section tone="warm">
    <div class="quote-embed reveal">
      <div class="card card--flush quote-embed__card">
        <iframe
          src={CALENDLY_URL}
          title="Book a free project consultation with Infused Agency"
          style="width: 100%; height: 740px; border: 0; display: block;"
        >
        </iframe>
      </div>
    </div>

    <div class="reveal" style="max-width: 44rem; margin: 3.5rem auto 0;">
      <ol class="quote-steps">
        <li>
          <span class="quote-steps__index">01</span>
          <div>
            <h3>We learn about your business</h3>
            <p>Your market, your goals and what a good enquiry looks like.</p>
          </div>
        </li>
        <li>
          <span class="quote-steps__index">02</span>
          <div>
            <h3>We review your visibility</h3>
            <p>Your website, Google Business Profile and the local competition.</p>
          </div>
        </li>
        <li>
          <span class="quote-steps__index">03</span>
          <div>
            <h3>You receive a written quote</h3>
            <p>A clear scope and a free, no-obligation quote for the work.</p>
          </div>
        </li>
      </ol>
    </div>
  </Section>
</BaseLayout>

<style>
  .quote-embed {
    max-width: 58rem;
    margin-inline: auto;
  }

  .quote-embed__card {
    box-shadow: var(--shadow-card);
  }
</style>
