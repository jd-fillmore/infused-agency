---
// Master location index. It links only to the two service roots and their
// live country hubs, so it can never point at a page that is not built.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import Icon from "../../components/ui/Icon.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Section from "../../components/ui/Section.astro";
import {
  liveCountries,
  liveCitiesInCountry,
  countryPath,
  serviceRootPath,
  getServiceConfig,
  SERVICES,
} from "../../lib/locations.mjs";
import { baseGraph, breadcrumbNode, serviceNode, webPageNode } from "../../lib/schema";

const pathname = "/ai-search/locations";
const title = "AI Search Optimization Locations | Canada & the US | Infused";
const description =
  "Every country and service where we publish AI search optimization and therapist SEO pages. Start with a service, then a country hub.";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "AI Search Optimization", href: "/ai-search-optimization" },
  { name: "Locations" },
];

const groups = SERVICES.map((config) => ({
  config,
  countries: liveCountries(config.slug).map((country: any) => ({
    country,
    count: liveCitiesInCountry(config.slug, country).length,
    href: countryPath(config.slug, country),
  })),
}));

const jsonLd = [
  ...baseGraph(),
  webPageNode({ url: pathname, name: title, description, type: "CollectionPage" }),
  breadcrumbNode(breadcrumbs, pathname),
  serviceNode({
    url: pathname,
    name: "Location directory for AI search optimization and therapist SEO",
    description,
    serviceType: "AI search optimization, therapist SEO",
  }),
];
---

<BaseLayout title={title} description={description} canonical={pathname} jsonLd={jsonLd}>
  <PageHero
    title="AI Search Optimization Locations"
    description="We publish location pages a batch at a time. This index lists only the services and countries with pages that are live today; regions and cities sit one level below each country hub."
    breadcrumbs={breadcrumbs}
    eyebrow="Locations"
    ctaLabel="Get a Free Quote"
  >
    <Fragment slot="aside">
      <h2>Start with a free quote</h2>
      <p>
        Tell us where you operate and what you sell. We will review your search
        and AI visibility, then send a written quote.
      </p>
      <ul class="page-hero__aside-list">
        <li><Icon name="check" /> Website and AI visibility review</li>
        <li><Icon name="check" /> Local competitor scan</li>
        <li><Icon name="check" /> Written, no-obligation quote</li>
      </ul>
      <Button href="/get-a-quote" variant="gold" block arrow>
        Get a Free Quote
      </Button>
    </Fragment>
  </PageHero>

  <Section
    eyebrow="Services"
    index="01"
    heading="Two services, one location system"
    description="Same hierarchical structure, separate content. A city can be live for one service and still a draft for the other."
  >
    <div class="prose reveal" style="max-width: 56rem;">
      <p>
        Every location page follows the same four-level URL pattern, for example
        <a href="/ai-search-optimization/canada/ontario/toronto"
          >/ai-search-optimization/canada/ontario/toronto</a
        >. We serve all of these markets remotely from the Niagara region in
        Ontario, Canada, and no page claims a local office anywhere else.
      </p>
    </div>
  </Section>

  <Section tone="tint" eyebrow="Directory" index="02" heading="Countries we publish">
    <div class="grid grid--2 reveal-group">
      {
        groups.map(({ config, countries }) => (
          <div class="card">
            <h3 class="card__title">
              <a href={serviceRootPath(config.slug)}>{config.name}</a>
            </h3>
            <p class="card__text">{config.locationLabel} across:</p>
            <ul class="chip-list" style="margin-top: 0.75rem;">
              {countries.map(({ country, count, href }: any) => (
                <li>
                  <a class="chip" href={href}>
                    {country.name} ({count})
                    <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    tone="contrast"
    eyebrow="Related"
    index="03"
    heading="Related services and specialists"
    description="The wider services connected to these location pages."
  >
    <ul class="chip-list">
      <li>
        <a class="chip" href="/ai-search-optimization">
          AI search optimization
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/seo">
          Search engine optimization
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/seo-for-therapists">
          SEO for therapists
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/results">
          Client results
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/get-a-quote">
          Get a Free Quote
          <Icon name="arrow-right" />
        </a>
      </li>
    </ul>
  </Section>

  <CtaBand
    eyebrow="Free quote"
    heading="Start where your customers ask their questions"
    description="Request a free quote and we will review how AI assistants currently describe your business, then send back a written quote with a clear scope."
    ctaLabel="Get a Free Quote"
  />
</BaseLayout>
