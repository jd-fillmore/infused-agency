---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostPage from "../../templates/BlogPostPage.astro";
import { getAllPosts } from "../../lib/posts";
import {
  authorNode,
  baseGraph,
  blogPostingNode,
  breadcrumbNode,
  faqPageNode,
  webPageNode,
} from "../../lib/schema";

export function getStaticPaths() {
  return getAllPosts().map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

// Up to three other posts from the same cluster, never this post. Manually
// assigned `related` slugs sort first; the rest follow newest-first.
const manual = post.related ?? [];
const related = getAllPosts()
  .filter(
    (candidate) =>
      candidate.id !== post.id && candidate.cluster && candidate.cluster === post.cluster
  )
  .sort((a, b) => {
    const rankA = manual.indexOf(a.id);
    const rankB = manual.indexOf(b.id);
    if (rankA !== -1 && rankB !== -1) return rankA - rankB;
    if (rankA !== -1) return -1;
    if (rankB !== -1) return 1;
    return new Date(b.date).getTime() - new Date(a.date).getTime();
  })
  .slice(0, 3);

const title = `${post.title} | Infused Agency`;
const description = post.excerpt;
const canonical = `/posts/${post.id}`;

const jsonLd = [
  ...baseGraph(),
  authorNode(),
  webPageNode({ url: canonical, name: title, description }),
  breadcrumbNode(
    [
      { name: "Home", href: "/" },
      { name: "Blog", href: "/blog" },
      { name: post.title },
    ],
    canonical
  ),
  blogPostingNode({
    url: canonical,
    headline: post.title,
    description,
    datePublished: post.date,
    image: post.image,
  }),
  ...(post.faqs?.length ? [faqPageNode(canonical, post.faqs)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={post.image}
  imageAlt={post.title}
  preloadImage={post.image}
  jsonLd={jsonLd}
>
  <BlogPostPage post={post} related={related} />
</BaseLayout>
