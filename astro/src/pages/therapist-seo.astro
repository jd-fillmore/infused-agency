---
import BaseLayout from "../layouts/BaseLayout.astro";
import VerticalPage from "../templates/VerticalPage.astro";
import { services } from "../lib/site";
import {
  baseGraph,
  breadcrumbNode,
  faqPageNode,
  serviceNode,
  webPageNode,
} from "../lib/schema";

import verticals from "../../../data/vertical-seo/verticals.json";
import provinces from "../../../data/vertical-seo/provinces.json";
import therapistContent from "../../../data/vertical-seo/content/verticals/therapists/canada.json";

const vertical = (verticals as Array<{ slug: string; urlSlug: string; displayName: string }>).find(
  (entry) => entry.urlSlug === "therapist-seo"
);

if (!vertical) {
  throw new Error("The therapists vertical record is missing.");
}

const title = "SEO for Therapists in Canada | Infused Agency";
const description = therapistContent.summary;

const provinceLinks = (provinces as Array<{ slug: string; name: string }>).map((province) => ({
  name: province.name,
  href: `/therapist-seo/${province.slug}`,
  cityCount: 0,
}));

const serviceLinks = services
  .filter((service) => service.relevantVerticals.includes("therapists"))
  .map((service) => ({ name: service.name, url: service.url }))
  .sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = [
  ...baseGraph(),
  webPageNode({ url: "/therapist-seo", name: title, description }),
  breadcrumbNode(
    [{ name: "Home", href: "/" }, { name: "SEO for Therapists in Canada" }],
    "/therapist-seo"
  ),
  serviceNode({
    url: "/therapist-seo",
    name: "SEO for Therapists in Canada",
    description,
    serviceType: "Therapist SEO",
  }),
  faqPageNode("/therapist-seo", therapistContent.faqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/therapist-seo"
  jsonLd={jsonLd}
>
  <VerticalPage
    h1="SEO for Therapists in Canada"
    description={description}
    verticalName="Therapists"
    content={therapistContent}
    provinces={provinceLinks}
    serviceLinks={serviceLinks}
  />
</BaseLayout>
