---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogIndexPage from "../../templates/BlogIndexPage.astro";
import { getAllPosts } from "../../lib/posts";
import { baseGraph, breadcrumbNode, webPageNode } from "../../lib/schema";

const title = "Infused Agency | Our Educational Blog";
const description =
  "Explore expert insights on web design and SEO, tailored to educate and empower clients. Discover strategies and tips to enhance your online presence and drive business growth.";

const posts = getAllPosts();

const jsonLd = [
  ...baseGraph(),
  webPageNode({ url: "/blog", name: title, description, type: "CollectionPage" }),
  breadcrumbNode([{ name: "Home", href: "/" }, { name: "Blog" }], "/blog"),
];
---

<BaseLayout title={title} description={description} canonical="/blog" jsonLd={jsonLd}>
  <BlogIndexPage posts={posts} />
</BaseLayout>
