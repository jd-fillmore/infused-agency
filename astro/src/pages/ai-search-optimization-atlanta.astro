---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accordion from "../components/ui/Accordion.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import PricingPlans from "../components/ui/PricingPlans.astro";
import Section from "../components/ui/Section.astro";
import { getIndustryPage } from "../lib/legacy-pages.mjs";
import { aiSearchPricingPlans } from "../lib/pricing";
import {
  baseGraph,
  breadcrumbNode,
  faqPageNode,
  serviceNode,
  webPageNode,
} from "../lib/schema";

const pathname = "/ai-search-optimization-atlanta";
const title = "AI Search Optimization Atlanta | Get Found on ChatGPT";
const description =
  "Is your Atlanta business invisible in ChatGPT and Google? AI search optimization to help you get found and chosen. Get a free audit.";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "SEO", href: "/seo" },
  { name: "Atlanta" },
];

const image = "/images/ai-search-optimization-atlanta.webp";
const imageAlt =
  "AI search optimization services for businesses looking for customers in Atlanta and across the metro";

// The Suk Law result is reused exactly as it appears on the existing
// /seo/for-law-firms-niagara page. Nothing in this block is edited or invented.
const sukLaw = getIndustryPage("/seo/for-law-firms-niagara") as
  | {
      proof: {
        heading: string;
        client: string;
        subhead?: string;
        label: string;
        image?: string;
        alt?: string;
        items?: string[];
      };
    }
  | undefined;

if (!sukLaw?.proof) {
  throw new Error("Missing Suk Law proof block for the Atlanta AI SEO page");
}

const proof = sukLaw.proof;

const faqs = [
  {
    q: "How can a smaller Atlanta business compete for AI search visibility?",
    a: "Size decides recognition, not relevance. An assistant asked about a niche service in Alpharetta or Decatur needs a clear, verifiable answer, and a focused company can supply it where a national brand gives a vague one. We build the pages and profiles that state your scope precisely enough to be included in that answer.",
  },
  {
    q: "Is AI SEO vs traditional SEO a choice, or do they work together?",
    a: "They build on each other, and pretending otherwise sells confusion. Clean crawl paths, accurate titles, real internal links and a maintained Google Business Profile remain the base. AI work then pushes the same facts further: passages written to be lifted, descriptions kept identical across sources and a periodic check on what assistants actually say. We strengthen what is already there.",
  },
  {
    q: "How should a multi-location business around Atlanta organise AI search pages?",
    a: "One page per real location, each with its own address, hours, phone and catchment — a Marietta branch and a Johns Creek branch should not read as the same text with the town swapped. Keep service pages separate from geography, and if a location is administrative rather than customer-facing, describe the service area honestly instead.",
  },
  {
    q: "How likely is ChatGPT to recommend our Atlanta business?",
    a: "No one can promise it. Assistants choose and rank their own sources, revise answers without warning and sometimes cite a directory nobody intended. What we control is whether your services, coverage and credentials read clearly and reconcile across sources. We report what changed and what we observed — never a promised citation.",
  },
  {
    q: "How long does AI SEO in Atlanta take to show any change?",
    a: "Nobody can date it responsibly. The variables are your starting site, how inconsistent your existing listings are, how busy your category is and how quickly useful pages can be produced. We sequence foundations and obvious errors first, then publish pages and re-check the same AI questions as the work settles.",
  },
  {
    q: "What does AI SEO cost for an Atlanta business?",
    a: "AI search is delivered as a 3-month implementation project with three packages: Starter ($329.99/month), Professional ($379.99/month) and Premium ($429.99/month), spread across a 12-month payment plan. The monthly amount is an installment toward the project rather than an ongoing retainer. A company with several locations and a long service catalogue may need a larger scope, which we confirm in a written quote after a free review.",
  },
  {
    q: "Do you work with businesses across metro Atlanta, not only inside the Perimeter?",
    a: "Yes. Infused Agency is based in St. Catharines, Ontario, and works with companies throughout metro Atlanta and elsewhere in the United States. Meetings happen remotely and travel is arranged when useful. What we never do is claim an Atlanta office or imply a storefront we do not have.",
  },
  {
    q: "How is AI search optimization in Atlanta measured?",
    a: "Before starting we record the baseline: search visibility, profile actions, calls, form submissions and a written note of how assistants describe the company. Reviews return to those measures. If one has stalled, the report says so and sets out the next recommendation instead of burying it.",
  },
];

const jsonLd = [
  ...baseGraph(),
  webPageNode({ url: pathname, name: title, description }),
  breadcrumbNode(breadcrumbs, pathname),
  serviceNode({
    url: pathname,
    name: "AI SEO services in Atlanta",
    description,
    serviceType:
      "AI SEO, AI search optimization, answer engine optimization (AEO) and generative engine optimization (GEO)",
    areaServed: [
      {
        "@type": "City",
        name: "Atlanta",
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "Georgia",
        },
      },
      { "@type": "City", name: "Sandy Springs" },
      { "@type": "City", name: "Roswell" },
      { "@type": "City", name: "Alpharetta" },
      { "@type": "City", name: "Marietta" },
      { "@type": "City", name: "Decatur" },
      { "@type": "City", name: "Smyrna" },
      { "@type": "City", name: "Johns Creek" },
      {
        "@type": "AdministrativeArea",
        name: "Georgia",
        containedInPlace: {
          "@type": "Country",
          name: "United States",
        },
      },
      { "@type": "Country", name: "United States" },
    ],
  }),
  faqPageNode(pathname, faqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={pathname}
  image={image}
  imageAlt={imageAlt}
  jsonLd={jsonLd}
>
  <PageHero
    title="AI SEO & Generative Search Optimization in Atlanta"
    description="Between Atlanta's startup scene and its national chains sits a middle market that still sells on reputation. We help those companies say what they do, who it serves and which suburbs they cover so plainly that an AI assistant can tell them apart from every lookalike on the same search."
    breadcrumbs={breadcrumbs}
    eyebrow="AI SEO Atlanta"
    ctaLabel="Get a Free Quote"
  >
    <Fragment slot="aside">
      <h2>Start with a free quote for AI SEO in Atlanta</h2>
      <p>
        Tell us about your business and we will review how you appear in
        Google, the map pack and AI answers, then send a written quote.
      </p>
      <ul class="page-hero__aside-list">
        <li><Icon name="check" /> Website and AI visibility review</li>
        <li><Icon name="check" /> Local competitor scan</li>
        <li><Icon name="check" /> Written, no-obligation quote</li>
      </ul>
      <Button href="/get-a-quote" variant="gold" block arrow>
        Get a Free Quote
      </Button>
    </Fragment>
  </PageHero>

  <Section
    eyebrow="A competitive field"
    index="01"
    heading="Why AI search optimization in Atlanta rewards a clearer offer"
  >
    <div class="split split--top">
      <div class="reveal">
        <div class="prose">
          <p>
            Atlanta has a habit of producing businesses that sound alike:
            logistics firms "solving supply chain complexity," contractors
            promising the best work in the Southeast, marketing shops claiming
            full-service everything. Whoever a buyer asks &mdash; Google or an
            assistant &mdash; those near-identical claims blur together, and
            the firms that win are the ones whose offer is concrete enough to
            be summarised without guesswork.
          </p>
          <p>
            The questions people now put to assistants are extremely specific.
            "Who repairs commercial roofs that close on Fridays?" "Which
            Roswell firm builds custom cabinetry for medical offices?" "Does
            anyone near Johns Creek handle fractional CFO work for
            restaurants?" A compact answer comes back, drawn from companies
            whose scope, service area and credentials are stated cleanly.
          </p>
          <p>
            That is the work: sharpen what you sell, mark the geography you
            actually cover &mdash; from Smyrna and Decatur to Alpharetta and
            beyond the Perimeter &mdash; and back every claim with evidence an
            assistant can verify. Infused Agency is based in St. Catharines
            and serves Atlanta businesses remotely; we do not pretend to keep
            an office in the city.
          </p>
          <p>
            If your company is in a different Southeast market, the same
            approach is described on our
            <a href="/ai-search-optimization-washington-dc">AI search optimization in Washington, DC</a>
            page.
          </p>
        </div>
      </div>
      <figure class="media-frame reveal">
        <img
          src={image}
          alt={imageAlt}
          width="1200"
          height="1800"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Section>

  <Section
    tone="tint"
    eyebrow="Services"
    index="02"
    heading="How an AI SEO agency in Atlanta approaches the work"
    description="The services below are connected, not a menu of shortcuts, and each one is scoped to how your company actually sells."
  >
    <div class="prose reveal" style="max-width: 56rem; margin-bottom: 2rem;">
      <p>
        The alphabet soup can be organised once in plain terms. AI SEO
        describes the overall effort to be understood and quoted by
        AI-assisted search. Answer engine optimization (AEO) is its writing
        layer &mdash; direct, extractable answers to the questions buyers
        actually ask. Generative Engine Optimization (GEO) looks at the wider
        set of sources assistants consult and how consistently your company is
        described across them. All three are extensions of ordinary SEO, not
        replacements for it.
      </p>
    </div>
    <div class="grid grid--3 reveal-group">
      <Card>
        <span class="service-card__number">01</span>
        <h3 class="card__title">AI SEO for Atlanta businesses with lookalike competitors</h3>
        <p class="card__text">
          Companies from Peachtree Corners to Peachtree Hills love the phrase
          "full-service," which is exactly why it persuades nobody and tells
          assistants nothing. We rewrite service pages so each offer carries
          its own scope, audience and deliverables, which is what a tool needs
          to describe you accurately.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">02</span>
        <h3 class="card__title">AI search optimization for firms that cross I-285</h3>
        <p class="card__text">
          Commuter geography shapes Atlanta commerce: a crew based in
          Smyrna may spend most of its week in Alpharetta, and clients care
          about the reality, not the postcode on the Google listing. We write
          coverage that matches travel patterns and avoids manufacturing a
          thin page for every suburb on the map.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">03</span>
        <h3 class="card__title">AEO services Atlanta: profiles that agree with your website</h3>
        <p class="card__text">
          Categories, service areas, hours and phone numbers get checked
          against your site and the major directories. An old suite number in
          Buckhead left inside a profile is enough to make an assistant
          hesitate, so contradictions are traced to their source and fixed
          there.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">04</span>
        <h3 class="card__title">How AEO helps Atlanta buyers before they enquire</h3>
        <p class="card__text">
          Pricing approach, lead times, warranty terms and what typically
          happens after an enquiry can be stated without promises. A short,
          factual paragraph gives a reader something usable and gives an
          assistant a passage it can borrow without inventing the details.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">05</span>
        <h3 class="card__title">Technical groundwork for AI SEO in Atlanta</h3>
        <p class="card__text">
          Crawlability, internal links, page speed, duplicate metadata and
          schema for services and locations decide whether any content can be
          read and trusted. We clear what blocks access first, then build on a
          base that actually performs.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">06</span>
        <h3 class="card__title">Optimizing for Google AI Overviews: a record over time</h3>
        <p class="card__text">
          Before we begin, we note what ChatGPT, Gemini and Google's AI
          Overviews currently say about your company, then re-ask the same
          questions on a schedule. A wrong description is traced back to the
          page or profile that fed it and corrected at the source.
        </p>
      </Card>
    </div>
  </Section>

  <Section tone="contrast" eyebrow="Proof" index="03" heading={proof.heading}>
    <div class="split split--top">
      <div class="reveal">
        <span class="badge">{proof.label}</span>
        <h3 class="h3" style="margin-top: 1rem; color: #ffffff;">{proof.client}</h3>
        {
          proof.subhead && (
            <p class="prose" style="margin-top: 1.1rem; color: var(--color-contrast-muted);">
              {proof.subhead}
            </p>
          )
        }
        {
          proof.items && proof.items.length > 0 && (
            <ul class="check-list" style="margin-top: 1.1rem;">
              {proof.items.map((item) => <li>{item}</li>)}
            </ul>
          )
        }
        <div style="margin-top: 1.75rem;">
          <Button href="/get-a-quote" variant="gold" arrow>
            Discuss a similar project
          </Button>
        </div>
      </div>
      {
        proof.image && (
          <figure class="media-frame reveal">
            <img
              src={proof.image}
              alt={proof.alt ?? `${proof.client} SEO results`}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </Section>

  <Section
    eyebrow="Who it's for"
    index="04"
    heading="AI SEO for Atlanta businesses with several locations"
  >
    <div class="split split--top">
      <div class="reveal">
        <div class="prose">
          <p>
            A single storefront in Decatur and a company with offices in
            Sandy Springs, Marietta and Johns Creek face different problems.
            The first needs to dominate a neighbourhood-scale set of searches.
            The second needs a site structure that keeps every branch findable
            without diluting the brand into interchangeable fragments.
          </p>
          <p>
            We work with service businesses, professional practices,
            retailers and B2B suppliers across the metro &mdash; owner-run
            companies and multi-location teams alike. The common thread is a
            considered purchase: someone compares their options before they
            call, book or sign. We shape the work around how that comparison
            happens in your category rather than a generic checklist.
          </p>
        </div>
      </div>
      <aside class="card reveal">
        <h3 class="card__title">Is an AI SEO agency in Atlanta the right fit?</h3>
        <ul class="check-list" style="margin-top: 1rem;">
          <li>You compete with larger brands on the same searches</li>
          <li>You serve a radius, a delivery zone or several metro locations</li>
          <li>Your services are easy to confuse with a competitor's</li>
          <li>You want one clear description across site and profiles</li>
          <li>You need reporting without inflated claims</li>
        </ul>
      </aside>
    </div>
  </Section>

  <Section
    eyebrow="Why Infused"
    index="05"
    heading="An AI SEO agency serving Atlanta that names what it cannot control"
  >
    <div class="split split--top">
      <div class="reveal">
        <div class="prose">
          <p>
            Infused Agency is based in St. Catharines, in the Niagara Region
            of Ontario, and works with Atlanta businesses remotely. That is
            the truthful version of our location, and it shapes the work:
            direct communication, a written scope and no invented local
            footprint.
          </p>
        </div>
      </div>
      <div class="grid grid--2" style="grid-template-columns: 1fr;">
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">AI SEO Atlanta content checked against your sources</h3>
          <p class="card__text">
            Copy is built from your services, coverage, hours and
            credentials. We will not add an Atlanta address, a client logo or
            a performance figure that cannot be traced to something you have
            approved.
          </p>
        </Card>
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">AI SEO vs traditional SEO: where each one helps</h3>
          <p class="card__text">
            Google, OpenAI and the other providers pick their own sources and
            change them at will. We improve the material they read; we do not
            sell a guaranteed position anywhere.
          </p>
        </Card>
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">Measuring how AI tools describe your Atlanta business</h3>
          <p class="card__text">
            Work starts by recording where you appear, what your profiles
            show and how assistants summarise you. Reports return to that
            baseline rather than cherry-picking a flattering number.
          </p>
        </Card>
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">Atlanta SEO fundamentals that AI search still depends on</h3>
          <p class="card__text">
            Useful pages, sensible architecture, accurate details and a fast
            site still determine most outcomes. AI search work extends those
            habits instead of replacing them with something exotic.
          </p>
        </Card>
      </div>
    </div>
  </Section>

  <PricingPlans
    id="seo-pricing"
    eyebrow="Pricing"
    index=""
    heading={aiSearchPricingPlans.heading}
    description={aiSearchPricingPlans.description}
    note={aiSearchPricingPlans.note}
    plans={aiSearchPricingPlans.plans}
    ctaLabel="Get a Free Quote"
  />

  <Section
    tone="warm"
    eyebrow="Questions"
    index="06"
    heading="How to get recommended by ChatGPT: Atlanta questions"
  >
    <Accordion items={faqs} />
  </Section>

  <Section
    tone="contrast"
    eyebrow="Related"
    index="07"
    heading="Further reading on AI search optimization"
    description="The services and pages connected to this work."
  >
    <ul class="chip-list">
      <li>
        <a class="chip" href="/ai-search">
          AI search optimization
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/ai-search/locations">
          All AI search optimization locations
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/ai-seo-for-therapists-atlanta">
          AI SEO for Therapists in Atlanta
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/ai-search-optimization-washington-dc">
          AI Search Optimization in Washington, DC
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/results">
          Client results
          <Icon name="arrow-right" />
        </a>
      </li>
      <li>
        <a class="chip" href="/get-a-quote">
          Get a Free Quote
          <Icon name="arrow-right" />
        </a>
      </li>
    </ul>
  </Section>

  <CtaBand
    eyebrow="Free quote"
    heading="Atlanta AI SEO that starts from facts you can verify"
    description="Send us your website and the parts of the metro you serve, from Decatur to Alpharetta. We will review your search and AI presence, then return a written quote with a clear scope."
    ctaLabel="Get a Free Quote"
  />
</BaseLayout>
