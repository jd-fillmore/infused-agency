---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/ui/Card.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import { getWorkProjects } from "../lib/legacy-pages.mjs";
import {
  baseGraph,
  breadcrumbNode,
  webPageNode,
} from "../lib/schema";

const pathname = "/results";
const title = "Infused Agency | Our Work";
const description =
  "We're passionate about putting in the work to deliver to our client's needs. Check out the results we've got for our clients";
const projects = getWorkProjects();

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Results" },
];

const jsonLd = [
  ...baseGraph(),
  webPageNode({ url: pathname, name: title, description }),
  breadcrumbNode(breadcrumbs, pathname),
];
---

<BaseLayout title={title} description={description} canonical={pathname} jsonLd={jsonLd}>
  <PageHero
    title="Featured Work"
    description="Our business solutions grow our clients' businesses."
    eyebrow="Our results"
    breadcrumbs={breadcrumbs}
    ctaLabel="Get a Free Quote"
  />

  <Section>
    <div class="prose reveal" style="max-width: 52rem;">
      <p>
        At Infused Agency, we don't just design websites &ndash; we create
        powerful online solutions that help businesses grow. From boosting
        search engine rankings with expert <a href="/seo">Niagara SEO</a>
        strategies to crafting stunning, lead-generating web designs, our work
        speaks for itself. Explore our featured projects to see how we have
        helped our clients achieve real results, increase visibility, and drive
        more customers to their businesses.
      </p>
    </div>
  </Section>

  {
    projects.map((project: any, index: number) => (
      <Section
        tone={index % 2 === 1 ? "tint" : "base"}
        eyebrow="Recent project"
        index={String(index + 2).padStart(2, "0")}
        heading={project.name}
      >
        <div class="split split--top">
          <div class="reveal">
            <p class="prose">{project.description}</p>
            <h3 class="h4" style="margin-top: 1.75rem;">Services delivered</h3>
            <ul class="check-list" style="margin-top: 1rem;">
              {project.services.map((service: string) => (
                <li>{service}</li>
              ))}
            </ul>
          </div>
          <Card class="reveal">
            <h3 class="card__title">After working with us</h3>
            <ul class="check-list" style="margin-top: 1rem;">
              {project.results.map((result: string) => (
                <li><Icon name="check" /> {result}</li>
              ))}
            </ul>
          </Card>
        </div>
      </Section>
    ))
  }

  <CtaBand
    eyebrow="Free quote"
    heading="Your project could be next"
    description="Tell us about your business and the results you want. We will send a free, no-obligation quote."
    ctaLabel="Get a Free Quote"
  />
</BaseLayout>
