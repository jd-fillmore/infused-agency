        links: [
          { href: "/seo/st-catharines", label: "St. Catharines" },
          { href: "/seo/thorold", label: "Thorold" },
          { href: "/seo/pelham", label: "Pelham" },
          { href: "/seo/fonthill", label: "Fonthill" },
