const jsonLd = [
  ...baseGraph(),
  webPageNode({ url: pathname, name: title, description }),
  breadcrumbNode(breadcrumbs, pathname),
  serviceNode({
    url: pathname,
    name: "SEO services in the Niagara Region",
    description,
    serviceType:
      "Local SEO, AI search optimization (GEO and AEO) and Google Business Profile management",
    areaServed: [
      {
        "@type": "AdministrativeArea",
        name: "Niagara Region",
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "Ontario",
        },
      },
      ...municipalities.map((name) => ({
        "@type": "AdministrativeArea",
        name,
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "Niagara Region",
        },
      })),
      ...communities.map(({ name, municipality }) => ({
        "@type": "Place",
        name,
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: municipality,
        },
      })),
    ],
  }),
  faqPageNode(pathname, faqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={pathname}
  jsonLd={jsonLd}
>
  <LocalSeoPage data={data} />
</BaseLayout>
