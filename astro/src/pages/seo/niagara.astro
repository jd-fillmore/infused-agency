// communities that have their own local pages. Communities are schema Places
// inside their municipality rather than cities in their own right.
const municipalities = [
  "Fort Erie",
  "Grimsby",
  "Lincoln",
  "Niagara Falls",
  "Niagara-on-the-Lake",
  "Pelham",
  "Port Colborne",
  "St. Catharines",
  "Thorold",
  "Wainfleet",
