---
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";

import Section from "../../../components/ui/Section.astro";
import { getIndustryPage } from "../../../lib/legacy-pages.mjs";


const image = "/images/ai-search-optimization-philadelphia.webp";
const imageAlt =
  "AI search optimization services for businesses looking for customers in Philadelphia and the Delaware Valley";

// The Suk Law result is reused exactly as it appears on the existing
// /seo/for-law-firms-niagara page. Nothing in this block is edited or invented.
const sukLaw = getIndustryPage("/seo/for-law-firms-niagara") as
  | {
      proof: {
        heading: string;
        client: string;
        subhead?: string;
        label: string;
        image?: string;
        alt?: string;
        items?: string[];
      };
    }
  | undefined;

if (!sukLaw?.proof) {
  throw new Error(
    "Missing Suk Law proof block for the Philadelphia AI SEO page"
  );
}

const proof = sukLaw.proof;

const faqs = [
  {
    q: "How can a smaller Philadelphia business compete for AI search visibility?",
    a: "Big-name firms win on familiarity, which doesn't help when the question is specific. A B2B supplier in Conshohocken or a Fishtown maker with unusual materials can be the clearest reply to a narrow, well-worded question. We write the pages that make those specific strengths impossible for an assistant to overlook.",
  },
  {
    q: "Is AI SEO vs traditional SEO a choice, or do they work together?",
    a: "AI search sits on the same foundations. Crawlable pages, sound internal linking, accurate titles and a current Google Business Profile come first; the AI layer then works that same material harder &mdash; answer-shaped paragraphs, identical facts across profiles and scheduled re-checks of what assistants actually report about you.",
  },
  {
    q: "How should a Greater Philadelphia business organise AI search pages across states?",
    a: "Honesty is the organising principle. One page per real location with its own address, hours and phone; service-area language for the work you genuinely cover across the King of Prussia corridor, the Main Line, South Jersey and Delaware. Mailing addresses that are not customer-facing should never masquerade as location pages.",
  },
  {
    q: "How likely is ChatGPT to recommend our Philadelphia business?",
    a: "Unpromisable, by anyone. Assistants assemble their own shortlists and rewrite their reach without notice. Our contribution is disciplined clarity &mdash; services, coverage and credentials stated consistently everywhere &mdash; plus reporting on exactly what we changed and what the tools subsequently said.",
  },
  {
    q: "How long does AI SEO in Philadelphia take to show any change?",
    a: "There is no date anyone can defend in advance. It depends on your starting site, how much your present listings contradict one another, how crowded your category is and how quickly good pages can be produced. Foundations and errors go first, publishing follows, and the same AI questions are re-checked over time.",
  },
  {
    q: "What does AI SEO cost for a Philadelphia business?",
    a: "AI search is delivered as a 3-month implementation project with three packages &mdash; Starter ($329.99/month), Professional ($379.99/month) and Premium ($429.99/month) &mdash; spread across a 12-month payment plan. The monthly amount is an installment toward the project rather than an ongoing retainer. Larger firms with several sites may need a bigger scope, confirmed in a written quote after a free review.",
  },
  {
    q: "Do you work with businesses across the Delaware Valley, not just Center City?",
    a: "Yes. Infused Agency is based in St. Catharines, Ontario, and works with companies from Northwest Philadelphia to Wilmington and elsewhere in the United States. Meetings run remotely and travel is arranged when useful. We never claim an Old City office we do not have.",
  },
  {
    q: "How is AI search optimization in Philadelphia measured?",
    a: "Measures are agreed in advance: search visibility, profile actions, calls, form submissions and a written record of how assistants describe the company. Reviews return to that baseline. Where a measure stalls, the report says so plainly and proposes the next step rather than dressing it up.",
  },
];

---

<Section
    tone="tint"
    eyebrow="Services"
    index="02"
    heading="How an AI SEO agency in Philadelphia approaches the work"
    description="The services below are connected, not a menu of shortcuts, and each one is scoped to how your company actually sells."
  >
    <div class="prose reveal" style="max-width: 56rem; margin-bottom: 2rem;">
      <p>
        Before the acronyms take over, here is the separation that matters.
        AI SEO is the overall effort to be understood and quoted by
        AI-assisted search. Answer engine optimization (AEO) is the writing
        layer &mdash; direct, extractable answers to the questions a Delaware
        Valley buyer would actually ask. Generative Engine Optimization (GEO)
        deals with every other source an assistant might consult and keeps
        your company's description consistent across them. All three are
        extensions of ordinary SEO.
      </p>
    </div>
    <div class="grid grid--3 reveal-group">
      <Card>
        <span class="service-card__number">01</span>
        <h3 class="card__title">AI SEO for Philadelphia businesses with interchangeable claims</h3>
        <p class="card__text">
          "Trusted since 1987" is not a differentiator when the shop across
          the street can match it. We rewrite service pages so every offer
          states its own audience, scope and boundaries &mdash; the content a
          tool needs to recommend you by name rather than substitute a
          generic answer.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">02</span>
        <h3 class="card__title">AI search optimization across a tri-state footprint</h3>
        <p class="card__text">
          Companies here trade in Pennsylvania, New Jersey and Delaware,
          sometimes from a single office. We write coverage that reflects
          where clients actually are &mdash; the Main Line, the Route 202
          corridor, Cherry Hill, Wilmington &mdash; instead of scattering thin
          pages across a map.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">03</span>
        <h3 class="card__title">AEO services Philadelphia: profiles that agree with your website</h3>
        <p class="card__text">
          Categories, service areas, hours and phone details are reconciled
          against your site and the directories that matter here. An old
          suite number from a previous Broad Street address is enough to
          stall an assistant, so contradictions are corrected at the source,
          not plastered over.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">04</span>
        <h3 class="card__title">How AEO helps Philadelphia buyers before they enquire</h3>
        <p class="card__text">
          Minimums, lead times, warranty terms and what follows a first call
          can all be stated without promises. Plain, factual paragraphs serve
          a sceptical local reader &mdash; and they double as the passages an
          assistant quotes when composing an answer.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">05</span>
        <h3 class="card__title">Technical groundwork for AI SEO in Philadelphia</h3>
        <p class="card__text">
          Crawlability, internal links, page speed, duplicate metadata and
          schema for services and offices determine whether content is even
          reachable. We clear what blocks access first so nothing new is
          built over a fault.
        </p>
      </Card>
      <Card>
        <span class="service-card__number">06</span>
        <h3 class="card__title">Optimizing for Google AI Overviews: a record over time</h3>
        <p class="card__text">
          What ChatGPT, Gemini and Google's AI Overviews currently say about
          your company gets written down before we start, then re-checked on
          a schedule. A wrong description is traced to the page or profile
          that supplied it and corrected there.
        </p>
      </Card>
    </div>
  </Section>

  <Section tone="contrast" eyebrow="Proof" index="03" heading={proof.heading}>
    <div class="split split--top">
      <div class="reveal">
        <span class="badge">{proof.label}</span>
        <h3 class="h3" style="margin-top: 1rem; color: #ffffff;">{proof.client}</h3>
        {
          proof.subhead && (
            <p class="prose" style="margin-top: 1.1rem; color: var(--color-contrast-muted);">
              {proof.subhead}
            </p>
          )
        }
        {
          proof.items && proof.items.length > 0 && (
            <ul class="check-list" style="margin-top: 1.1rem;">
              {proof.items.map((item) => <li>{item}</li>)}
            </ul>
          )
        }
        <div style="margin-top: 1.75rem;">
          <Button href="/get-a-quote" variant="gold" arrow>
            Discuss a similar project
          </Button>
        </div>
      </div>
      {
        proof.image && (
          <figure class="media-frame reveal">
            <img
              src={proof.image}
              alt={proof.alt ?? `${proof.client} SEO results`}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </Section>

  <Section
    eyebrow="Who it's for"
    index="04"
    heading="AI SEO for Greater Philadelphia businesses with several locations"
  >
    <div class="split split--top">
      <div class="reveal">
        <div class="prose">
          <p>
            A maker with one workshop in Kensington and a firm with offices
            in Ardmore, Conshohocken and Cherry Hill face different
            challenges. The first needs to be the obvious answer in its own
            corner of the city. The second needs a structure that keeps every
            location distinct, licensed where required, and easy to find
            without diluting what the brand stands for.
          </p>
          <p>
            We work with service businesses, professional practices,
            retailers and B2B suppliers across the Delaware Valley, from
            owner-run companies to multi-site teams. The shared trait is a
            considered purchase: someone weighs their options before they
            call, book or commission. We match the scope of work to how that
            comparison actually happens in your category, not a checklist.
          </p>
        </div>
      </div>
      <aside class="card reveal">
        <h3 class="card__title">Is an AI SEO agency in Philadelphia the right fit?</h3>
        <ul class="check-list" style="margin-top: 1rem;">
          <li>You compete with larger brands on the same searches</li>
          <li>You serve a radius, a delivery zone or several metro locations</li>
          <li>Your services are easy to confuse with a competitor's</li>
          <li>You want one clear description across site and profiles</li>
          <li>You need reporting without inflated claims</li>
        </ul>
      </aside>
    </div>
  </Section>

  <Section
    eyebrow="Why Infused"
    index="05"
    heading="An AI SEO agency serving Philadelphia that names what it cannot control"
  >
    <div class="split split--top">
      <div class="reveal">
        <div class="prose">
          <p>
            Infused Agency works from St. Catharines, in the Niagara Region
            of Ontario, partnering with Philadelphia businesses remotely.
            That is the whole truth of our location, and it drives a simple
            operating style: direct communication, written scope and no
            invented footprint in the Delaware Valley.
          </p>
        </div>
      </div>
      <div class="grid grid--2" style="grid-template-columns: 1fr;">
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">AI SEO Philadelphia content checked against your sources</h3>
          <p class="card__text">
            Copy is drawn strictly from your services, coverage, hours and
            credentials. We will not add a Market Street address, a client
            logo or a performance figure that cannot be traced to a document
            you have approved.
          </p>
        </Card>
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">AI SEO vs traditional SEO: where each one helps</h3>
          <p class="card__text">
            Providers set and change their own sources, which is why no
            honest position can be sold. What we improve is the material
            those systems read and the consistency with which it repeats.
          </p>
        </Card>
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">Measuring how AI tools describe your Philadelphia business</h3>
          <p class="card__text">
            Where you appear, what your profiles show and how assistants
            summarise the company are recorded before the work begins, and
            reports always return to that baseline.
          </p>
        </Card>
        <Card class="reveal">
          <h3 class="card__title" style="margin-top: 0;">Philadelphia SEO fundamentals that AI search still depends on</h3>
          <p class="card__text">
            Useful pages, sensible architecture, correct details and fast
            load times remain what moves results. AI search work adds
            precision on top of them; it does not replace them.
          </p>
        </Card>
      </div>
    </div>
  </Section>











