const isSocial = name in socialPaths;
const paths = strokePaths[name] ?? strokePaths.globe;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={isSocial ? "currentColor" : "none"}
  stroke={isSocial ? "none" : "currentColor"}
  stroke-width={isSocial ? undefined : "1.8"}
  stroke-linecap={isSocial ? undefined : "round"}
  stroke-linejoin={isSocial ? undefined : "round"}
>
  {isSocial ? <path d={socialPaths[name]} /> : paths.map((d) => <path d={d} />)}
</svg>
