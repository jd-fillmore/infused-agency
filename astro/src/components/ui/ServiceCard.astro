---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  number?: string;
  linkLabel?: string;
  featured?: boolean;
}

const { title, description, href, number, linkLabel = "Learn more", featured = false } = Astro.props;
---

<article class:list={["card", "card--interactive", "service-card", featured && "service-card--featured"]}>
  <div class="service-card__top">
    {number && <span class="service-card__number">{number}</span>}
    <span class="service-card__arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
  </div>
  <h3 class="service-card__title">
    <a href={href}>{title}</a>
  </h3>
  <p class="service-card__text">{description}</p>
  <div class="service-card__link">
    <a class="link-arrow" href={href} aria-label={`Learn more about ${title}`}>
      {linkLabel}
      <Icon name="arrow-right" />
    </a>
  </div>
</article>

<style>
  .service-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .service-card__title a:focus-visible {
    color: var(--color-accent);
    text-decoration: none;
  }

  .service-card--featured .service-card__title a:focus-visible {
    color: var(--color-gold-bright);
  }

  @media (hover: hover) {
    .service-card__title a:hover {
      color: var(--color-accent);
      text-decoration: none;
    }

    .service-card--featured .service-card__title a:hover {
      color: var(--color-gold-bright);
    }
  }
</style>
