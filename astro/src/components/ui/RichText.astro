---
interface Props {
  text: string;
}

const { text } = Astro.props;

// Site copy is authored in this repository, so it is trusted. Two link styles
// exist in it: inline HTML (`<a href="/...">label</a>`, used by the location
// and service overrides) and legacy Markdown tokens (`[label](/href)`). Both
// must render as real links, so convert the Markdown tokens to anchors and
// render the result as HTML rather than escaping it.
const withLinks = text.replace(
  /\[([^\]]+)\]\(([^)\s]+)\)/g,
  (_match, label: string, href: string) => `<a href="${href}">${label}</a>`
);
---
<Fragment set:html={withLinks} />
