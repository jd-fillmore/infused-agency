---
import Icon from "../ui/Icon.astro";
import { siteFacts } from "../../lib/site";

const company = [
  { name: "Results", href: "/results" },
  { name: "About", href: "/about" },
  { name: "Blog", href: "/blog" },
  { name: "Sitemap", href: "/sitemap" },
];

const socials = siteFacts.socialProfiles
  .filter((profile) => ["Instagram", "Facebook"].includes(profile.platform))
  .map((profile) => ({
    ...profile,
    icon: profile.platform.toLowerCase(),
  }));

---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <a class="brand" href="/" aria-label="Infused Agency home">
          infused<span>.</span>
        </a>
        <p>
          Infused is a boutique SEO, AI search and web design agency helping
          businesses get found on Google and in AI search tools like ChatGPT
          and Gemini.
        </p>
        <ul class="social-list">
          {
            socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noreferrer" aria-label={social.platform}>
                  <Icon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2>Services</h2>
        <ul class="footer-list">
          <li><a href="/seo">SEO</a></li>
          <li><a href="/ai-search">AI Search</a></li>
          <li><a href="/web-design">Web Design</a></li>
        </ul>
      </div>

      <div>
        <h2>Company</h2>
        <ul class="footer-list">
          {company.map((item) => <li><a href={item.href}>{item.name}</a></li>)}
        </ul>

        <div class="site-footer__contact" style="margin-top: 1.5rem;">
          <h2>Contact</h2>
          <span>{siteFacts.address.addressLocality}, {siteFacts.address.addressRegion}</span>
          <span>Mon&ndash;Fri, 9 a.m.&ndash;6 p.m.</span>
          <a class="footer-phone visually-hidden" href={`tel:+1${siteFacts.phone.replace(/\D/g, "")}`} aria-label="Phone number">{siteFacts.phone}</a>
          <a href={`mailto:${siteFacts.email}`}>{siteFacts.email}</a>
          <a class="link-arrow" href="/get-a-quote">
            Get a Free Quote
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="site-footer__wordmark" aria-hidden="true">
    <span>infused.</span>
  </div>

  <div class="site-footer__bottom">
    <div class="container">
      <div class="site-footer__bottom-inner">
        <p>Infused Agency &mdash; SEO, AI search and web design.</p>
        <div>
          <a href="/privacy-policy">Privacy Policy</a>
          <span aria-hidden="true">&middot;</span>
          <a href="/get-a-quote">Get a Free Quote</a>
        </div>
      </div>
    </div>
  </div>
</footer>
