---
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import { formatPostDate, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<PageHero
  title={post.title}
  description={post.excerpt}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog" },
    { name: post.title },
  ]}
  eyebrow="Journal"
  meta={formatPostDate(post.date)}
  showCta={false}
  compact
/>

<Section tone="warm">
  <div class="article-layout">
    <article class="reveal">
      {
        post.image && (
          <div class="article-cover">
            <img
              src={post.image}
              alt={post.title}
              width="1200"
              height="600"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div class="article-byline">
        <div class="article-byline__mark" aria-hidden="true">JD</div>
        <div>
          <p class="article-byline__name">
            By <a href="/about">JD Fillmore</a>
            <span>&middot; Founder &amp; Owner, Infused Agency</span>
          </p>
          <p class="article-byline__bio">
            JD leads strategy, design and delivery at Infused Agency, with
            hands-on experience in local SEO and conversion-focused web design.
          </p>
        </div>
      </div>
      <div class="article-body" set:html={post.html} />
      <div class="article-footer">
        <a class="link-arrow" href="/blog">
          <Icon name="arrow-left" />
          Back to all articles
        </a>
        <a class="link-arrow" href="/get-a-quote">
          Get a Free Quote
          <Icon name="arrow-right" />
        </a>
      </div>
    </article>

    <aside class="article-aside reveal">
      <p class="eyebrow">Free quote</p>
      <h2 style="margin-top: 0.8rem;">Want help applying this?</h2>
      <p>
        Request a free quote and we will look at your site, your local
        visibility and the searches that matter to your business.
      </p>
      <Button href="/get-a-quote" variant="primary" block arrow>Get a Free Quote</Button>
      <div class="article-aside__links">
        <a class="link-arrow" href="/seo">Explore SEO services <Icon name="arrow-right" /></a>
        <a class="link-arrow" href="/blog">More articles <Icon name="arrow-right" /></a>
      </div>
    </aside>
  </div>
</Section>

<style>
  .article-byline {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: var(--border-hairline);
  }

  .article-byline__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .article-byline__name {
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .article-byline__name span {
    color: var(--color-muted);
    font-weight: 400;
  }

  .article-byline__bio {
    max-width: 42rem;
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>

<CtaBand
  eyebrow="Free quote"
  heading="Want more of the right visitors?"
  description="Request a free quote and we will map the local visibility and content work that will earn attention."
  ctaLabel="Get a Free Quote"
/>
