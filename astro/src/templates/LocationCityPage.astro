---
/**
 * One city page for one service. Renders from the city record in
 * src/data/locations.json plus the city content file. Pages migrated from the
 * old flat URLs keep their bespoke body (src/components/locations/bodies) and
 * gain the shared header, coverage, FAQ, nearby-cities and explore blocks.
 */
import Accordion from "../components/ui/Accordion.astro";
import Card from "../components/ui/Card.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import HeroImage from "../components/ui/HeroImage.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import TestimonialCard from "../components/ui/TestimonialCard.astro";
import NearbyCities from "../components/locations/NearbyCities.astro";
import { siteFacts } from "../lib/site";
import { getServiceConfig, countryPath, regionPath, serviceRootPath } from "../lib/locations.mjs";
import proofJson from "../../../data/vertical-seo/proof.json";

interface Props {
  service: string;
  record: any;
  content: any;
  seo: { title: string; description: string; h1: string };
  neighbours: any[];
  sibling: { href: string; label: string } | null;
}

const { service, record, content, seo, neighbours, sibling } = Astro.props;
const config = getServiceConfig(service);
const { country, region, city } = record;
const cityName = city.title_name ?? city.name;

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: config.rootLabel, href: serviceRootPath(service) },
  { name: country.name, href: countryPath(service, country) },
  { name: region.name, href: regionPath(service, country, region) },
  { name: cityName },
];

const bodies = import.meta.glob("../components/locations/bodies/*.astro", { eager: true }) as Record<
  string,
  { default: any }
>;
const BodyComponent = content.legacy_body
  ? bodies[`../components/locations/bodies/${content.legacy_body}.astro`]?.default
  : null;

if (content.legacy_body && !BodyComponent) {
  throw new Error(`Missing migrated body component: ${content.legacy_body}`);
}

const marketIsHtml = typeof content.local_market_context === "string";
const marketParagraphs: string[] = marketIsHtml ? [] : (content.local_market_context ?? []);

type ProofEntry = {
  id: string;
  type: string;
  person?: string;
  role?: string;
  namedEntity?: string;
  quote?: string;
  verticals?: string[];
};

const therapistProof = (proofJson as ProofEntry[]).filter(
  (entry) => entry.type === "testimonial" && (entry.verticals ?? []).includes("therapists")
);
const brandi = siteFacts.testimonials.find(
  (testimonial) => testimonial.id === "brandi-may-psychotherapy"
);
const testimonials = [
  therapistProof.find((entry) => entry.id === "nicole-p"),
  brandi,
  therapistProof.find((entry) => entry.id === "courtney-v"),
]
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry?.person && entry.quote))
  .map((entry) => ({
    person: entry.person,
    role: entry.role,
    company: (entry as { namedEntity?: string }).namedEntity,
    quote: entry.quote,
  }));

const exploreLinks = [
  { href: regionPath(service, country, region), label: `${region.name} ${config.shortName} locations` },
  ...(sibling ? [sibling] : []),
  { href: serviceRootPath(service), label: `${config.name} services` },
  { href: "/ai-search/locations", label: "All AI search optimization locations" },
  { href: "/results", label: "Client results" },
  { href: "/get-a-quote", label: "Get a Free Quote" },
];
---

<PageHero
  title={seo.h1}
  description={content.hero?.description}
  breadcrumbs={breadcrumbs}
  eyebrow={content.hero?.eyebrow ?? config.shortName}
  ctaLabel="Get a Free Quote"
>
  {
    content.hero?.image && (
      <Fragment slot="aside">
        <HeroImage src={content.hero.image} alt={content.hero.imageAlt ?? `${cityName} ${config.shortName}`} />
      </Fragment>
    )
  }
</PageHero>

<Section tight eyebrow="Coverage" index="01" heading={`Where we work in ${cityName}`}>
  <div class="split split--top">
    <div class="reveal prose">
      <p>
        We serve {cityName} businesses and practices remotely from the Niagara
        region in Ontario, Canada. There is no {cityName} office: the work
        happens online, and every claim on this page is about what we can do
        from here.
      </p>
      <p>
        The neighbourhoods below are the parts of {cityName} we write for and
        track in search. Knowing them keeps the copy specific instead of
        repeating the city name and hoping.
      </p>
    </div>
    <aside class="callout reveal">
      <h3>Neighbourhoods and areas</h3>
      <ul class="check-list" style="margin-top: 1rem;">
        {(content.neighbourhoods ?? []).map((neighbourhood: string) => <li>{neighbourhood}</li>)}
      </ul>
      {
        content.regulatory_body && (
          <p class="card__text" style="margin-top: 1.25rem;">
            Licensing:{" "}
            <a href={content.regulatory_body.url} rel="noopener" target="_blank">
              {content.regulatory_body.name}
            </a>
            . Providers in this province or state are regulated by that body; we
            write to its advertising expectations.
          </p>
        )
      }
    </aside>
  </div>
</Section>

{
  content.market_heading && (
    <Section eyebrow={content.market_eyebrow ?? "The local market"} index="02" heading={content.market_heading}>
      {marketIsHtml ? (
        <div class="prose reveal" style="max-width: 56rem;" set:html={content.local_market_context} />
      ) : (
        <div class="prose reveal" style="max-width: 56rem;">
          {marketParagraphs.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      )}
    </Section>
  )
}

{
  BodyComponent ? (
    <BodyComponent />
  ) : (
    <>
      {content.services?.cards?.length && (
        <Section
          tone="tint"
          eyebrow="Services"
          index="03"
          heading={content.services.heading}
          description={content.services.description}
        >
          <div class="grid grid--3 reveal-group">
            {content.services.cards.map((card: { title: string; body: string }, index: number) => (
              <Card>
                <span class="service-card__number">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="card__title">{card.title}</h3>
                <p class="card__text">{card.body}</p>
              </Card>
            ))}
          </div>
        </Section>
      )}

      {content.ai?.paragraphs?.length && (
        <Section tone="warm" eyebrow="AI search" index="04" heading={content.ai.heading}>
          <div class="prose reveal" style="max-width: 56rem;">
            {content.ai.paragraphs.map((paragraph: string) => (
              <p set:html={paragraph} />
            ))}
          </div>
        </Section>
      )}

      {content.who?.heading && (
        <Section eyebrow="Who it's for" index="05" heading={content.who.heading}>
          <div class="split split--top">
            <div class="reveal">
              <div class="prose">
                {(content.who.paragraphs ?? []).map((paragraph: string) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </div>
            {content.who.fitItems?.length && (
              <aside class="card reveal">
                <h3 class="card__title">A good fit if you are</h3>
                <ul class="check-list" style="margin-top: 1rem;">
                  {content.who.fitItems.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </aside>
            )}
          </div>
        </Section>
      )}

      {content.why?.heading && (
        <Section eyebrow="Why Infused" index="06" heading={content.why.heading}>
          <div class="split split--top">
            <div class="reveal">
              <div class="prose">
                <p>{content.why.paragraph}</p>
              </div>
            </div>
            <div class="grid grid--2" style="grid-template-columns: 1fr;">
              {(content.why.cards ?? []).map((card: { title: string; body: string }) => (
                <Card class="reveal">
                  <h3 class="card__title" style="margin-top: 0;">
                    {card.title}
                  </h3>
                  <p class="card__text">{card.body}</p>
                </Card>
              ))}
            </div>
          </div>
        </Section>
      )}

      {service === "seo-for-therapists" && testimonials.length > 0 && (
        <div data-shared>
          <Section
            tone="contrast"
            eyebrow="Testimonials"
            index="07"
            heading={content.testimonial_heading ?? "What therapists say about working with an AI SEO agency"}
          >
            <div class="grid grid--3 reveal-group">
              {testimonials.map((testimonial) => (
                <TestimonialCard
                  quote={testimonial.quote!}
                  person={testimonial.person!}
                  role={testimonial.role}
                  company={testimonial.company}
                />
              ))}
            </div>
          </Section>
        </div>
      )}
    </>
  )
}

<Section
  tone="warm"
  eyebrow="Questions"
  index="08"
  heading={content.faq_heading ?? `Questions about ${config.locationLabel} in ${cityName}`}
>
  <Accordion items={content.faqs} />
</Section>

<NearbyCities cityName={cityName} neighbours={neighbours} serviceLabel={config.name} />

<Section
  tone="contrast"
  eyebrow="Related"
  index=""
  heading={`More ${config.shortName} across ${region.name} and beyond`}
  description="Parent location, sister service and the pages connected to this work."
>
  <ul class="chip-list" data-shared>
    {
      exploreLinks.map((link) => (
        <li>
          <a class="chip" href={link.href}>
            {link.label}
            <Icon name="arrow-right" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<CtaBand
  eyebrow="Free quote"
  heading={content.cta?.heading ?? `${config.shortName} for ${cityName}`}
  description={content.cta?.description ??
    `Tell us about your business in ${cityName}. We will review your search and AI visibility, then send a written quote with a clear scope.`}
  ctaLabel="Get a Free Quote"
/>
