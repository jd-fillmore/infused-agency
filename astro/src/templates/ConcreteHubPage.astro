---
import Accordion from "../components/ui/Accordion.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import PricingPlans from "../components/ui/PricingPlans.astro";
import RichText from "../components/ui/RichText.astro";
import Section from "../components/ui/Section.astro";
import { seoPricingPlans } from "../lib/pricing";

interface Props {
  data: {
    niche: { slug: string; name: string };
    hub: {
      seo: { title: string; description: string };
      hero: { title: string; description: string };
      intro: { heading: string; paragraphs: string[] };
      jobs: { heading: string; paragraphs: string[] };
      whatWeDo: {
        heading: string;
        paragraphs: string[];
        checklist?: string[];
      };
      niagara: { heading: string; paragraphs: string[] };
      faqs: Array<{ q: string; a: string }>;
    };
    urlPath: string;
    breadcrumbs: Array<{ name: string; href?: string }>;
    groups: Array<{
      province: { slug: string; name: string };
      cities: Array<{
        slug: string;
        name: string;
        href: string;
        published: boolean;
      }>;
    }>;
  };
}

const { data } = Astro.props;
const { hub, groups } = data;
const publishedGroups = groups.filter((group) =>
  group.cities.some((city) => city.published)
);
---

<PageHero
  title={hub.hero.title}
  description={hub.hero.description}
  breadcrumbs={data.breadcrumbs}
  eyebrow="Canada-wide SEO"
  ctaLabel="Get a Free Quote"
>
  <Fragment slot="aside">
    <h2>Start with a free quote</h2>
    <p>
      Tell us where your concrete crews work and the jobs you want more of. We
      will review your website and local visibility, then send a clear written
      quote.
    </p>
    <ul class="page-hero__aside-list">
      <li><Icon name="check" /> Website and content review</li>
      <li><Icon name="check" /> Google Business Profile check</li>
      <li><Icon name="check" /> A clear written quote</li>
    </ul>
    <Button href="/get-a-quote" variant="gold" block arrow>Get a Free Quote</Button>
  </Fragment>
</PageHero>

<Section>
  <div class="split split--top">
    <div class="reveal">
      <p class="eyebrow"><span class="eyebrow__index">01</span> The opportunity</p>
      <h2 class="h2" style="margin-top: 1rem;">{hub.intro.heading}</h2>
      <div class="prose" style="margin-top: 1.25rem;">
        {hub.intro.paragraphs.map((paragraph) => (
          <p><RichText text={paragraph} /></p>
        ))}
      </div>
    </div>
    <aside class="card reveal">
      <h3 class="card__title">Where we work</h3>
      <p class="card__text">
        Based in St. Catharines, Ontario, working with concrete contractors
        across Canada remotely.
      </p>
      <ul class="check-list" style="margin-top: 1rem;">
        <li>Dedicated pages for the concrete services you sell</li>
        <li>City and regional pages for the areas you cover</li>
        <li>Google Business Profile and review signals</li>
      </ul>
    </aside>
  </div>
</Section>

<Section tone="contrast" eyebrow="Demand" index="02" heading={hub.jobs.heading}>
  <div class="prose reveal" style="max-width: 52rem;">
    {hub.jobs.paragraphs.map((paragraph) => (
      <p><RichText text={paragraph} /></p>
    ))}
  </div>
</Section>

<Section tone="tint" eyebrow="What we do" index="03" heading={hub.whatWeDo.heading}>
  <div class="split split--top">
    <div class="prose reveal">
      {hub.whatWeDo.paragraphs.map((paragraph) => (
        <p><RichText text={paragraph} /></p>
      ))}
    </div>
    {
      hub.whatWeDo.checklist && hub.whatWeDo.checklist.length > 0 && (
        <aside class="card reveal">
          <h3 class="card__title">What to expect</h3>
          <ul class="check-list" style="margin-top: 1rem;">
            {hub.whatWeDo.checklist.map((item) => <li><RichText text={item} /></li>)}
          </ul>
        </aside>
      )
    }
  </div>
</Section>

<Section eyebrow="City pages" index="04" heading="SEO for Concrete Contractors across Canada" description="Each city below has its own page covering local competition, the searches people use, and the work we do there.">
  <div style="display: grid; gap: 2.5rem;">
    {
      publishedGroups.map((group) => (
        <div class="reveal">
          <h3 class="h3" style="margin-bottom: 1rem;">{group.province.name}</h3>
          <ul class="chip-list">
            {group.cities
              .filter((city) => city.published)
              .map((city) => (
                <li>
                  <a class="chip" href={city.href}>
                    SEO for Concrete Contractors in {city.name}
                    <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<Section tone="warm" eyebrow="Niagara" index="05" heading={hub.niagara.heading}>
  <div class="prose reveal" style="max-width: 52rem;">
    {hub.niagara.paragraphs.map((paragraph) => (
      <p><RichText text={paragraph} /></p>
    ))}
  </div>
</Section>

<PricingPlans
  id="seo-pricing"
  eyebrow="Pricing"
  index=""
  heading={seoPricingPlans.heading}
  description={seoPricingPlans.description}
  note={seoPricingPlans.note}
  plans={seoPricingPlans.plans}
  ctaLabel="Get a Free Quote"
/>

{
  hub.faqs.length > 0 && (
    <Section eyebrow="Questions" index="06" heading="Frequently asked questions">
      <Accordion items={hub.faqs} />
    </Section>
  )
}

<CtaBand
  eyebrow="Free quote"
  heading="Win more concrete work across Canada"
  description="Request a free quote and we will map what it takes to get your business found in the cities you serve."
  ctaLabel="Get a Free Quote"
/>
