---
import Accordion from "../components/ui/Accordion.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";

interface LocalSeoPageData {
  city: string;
  hero: { title: string; description: string; image?: string; alt?: string };
  marketIntro: { heading: string; paragraphs: string[] };
  proof: {
    heading: string;
    client: string;
    label: string;
    image?: string;
    alt?: string;
    items: string[];
  };
  whyNeeded: { heading: string; paragraphs: string[]; checklist: string[] };
  services: {
    heading: string;
    subhead: string;
    cards: Array<{ title: string; paragraphs: string[] }>;
  };
  whyChoose: {
    heading: string;
    paragraphs: string[];
    awards?: { image: string; alt: string };
    blocks: Array<{
      title: string;
      paragraphs: string[];
      checklist?: string[];
      paragraphsAfter?: string[];
    }>;
    closingHeading?: string;
    closingParagraphs?: string[];
  };
  faqs: Array<{ q: string; a: string }>;
  relatedLinks: Array<{ href: string; label: string }>;
}

interface Props {
  data: LocalSeoPageData;
}

const { data } = Astro.props;
---

<PageHero
  title={data.hero.title}
  description={data.hero.description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "SEO", href: "/seo" },
    { name: data.city },
  ]}
  eyebrow="Local SEO"
  ctaLabel="Get a free quote"
>
  <Fragment slot="aside">
    <h2>Free local visibility review</h2>
    <p>
      See how your business appears in local search, the map pack and AI answers,
      and what to fix first.
    </p>
    <ul class="page-hero__aside-list">
      <li><Icon name="check" /> Google Business Profile check</li>
      <li><Icon name="check" /> Local competitor scan</li>
      <li><Icon name="check" /> Written, no-obligation quote</li>
    </ul>
    <Button href="/get-a-quote" variant="gold" block arrow>Book a free consultation</Button>
  </Fragment>
</PageHero>

<Section>
  <div class="split">
    <div class="reveal">
      <p class="eyebrow"><span class="eyebrow__index">01</span> The local market</p>
      <h2 class="h2" style="margin-top: 1rem;">{data.marketIntro.heading}</h2>
      <div class="prose" style="margin-top: 1.25rem;">
        {data.marketIntro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    {
      data.hero.image && (
        <figure class="media-frame reveal">
          <img
            src={data.hero.image}
            alt={data.hero.alt ?? `${data.city} local SEO`}
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }
  </div>
</Section>

<Section tone="contrast" eyebrow="Recent project" index="02" heading={data.proof.heading}>
  <div class="split split--top">
    <div class="reveal">
      <span class="badge">{data.proof.label}</span>
      <h3 class="h3" style="margin-top: 1rem; color: #ffffff;">{data.proof.client}</h3>
      <ul class="check-list" style="margin-top: 1.1rem;">
        {data.proof.items.map((item) => <li>{item}</li>)}
      </ul>
      <div style="margin-top: 1.75rem;">
        <Button href="/get-a-quote" variant="gold" arrow>Discuss a similar project</Button>
      </div>
    </div>
    {
      data.proof.image && (
        <figure class="media-frame reveal">
          <img
            src={data.proof.image}
            alt={data.proof.alt ?? `${data.proof.client} SEO results`}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
  </div>
</Section>

<Section>
  <div class="split split--top">
    <div class="reveal">
      <p class="eyebrow"><span class="eyebrow__index">03</span> Why it matters</p>
      <h2 class="h2" style="margin-top: 1rem;">{data.whyNeeded.heading}</h2>
      <div class="prose" style="margin-top: 1.25rem;">
        {data.whyNeeded.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="callout reveal">
      <h3>What the work covers</h3>
      <ul class="check-list" style="margin-top: 1rem;">
        {data.whyNeeded.checklist.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</Section>

<Section
  tone="tint"
  eyebrow="Services"
  index="04"
  heading={data.services.heading}
  description={data.services.subhead}
>
  <div class="grid grid--3 reveal-group">
    {
      data.services.cards.map((card, index) => (
        <Card>
          <span class="service-card__number">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="card__title">{card.title}</h3>
          {card.paragraphs.map((paragraph) => <p class="card__text">{paragraph}</p>)}
        </Card>
      ))
    }
  </div>
</Section>

<Section eyebrow="Why Infused" index="05" heading={data.whyChoose.heading}>
  <div class="split split--top">
    <div class="reveal">
      <div class="prose">
        {data.whyChoose.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {
        data.whyChoose.awards && (
          <div class="card" style="max-width: 30rem; margin-top: 1.75rem; padding: 1.25rem;">
            <img
              src={data.whyChoose.awards.image}
              alt={data.whyChoose.awards.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }
    </div>
    <div class="grid grid--2" style="grid-template-columns: 1fr;">
      {
        data.whyChoose.blocks.map((block) => (
          <Card class="reveal">
            <h3 class="card__title" style="margin-top: 0;">{block.title}</h3>
            {block.paragraphs.map((paragraph) => <p class="card__text">{paragraph}</p>)}
            {block.checklist && (
              <ul class="check-list" style="margin-top: 1rem;">
                {block.checklist.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {block.paragraphsAfter?.map((paragraph) => <p class="card__text">{paragraph}</p>)}
          </Card>
        ))
      }
    </div>
  </div>

  {
    data.whyChoose.closingHeading && (
      <div class="reveal" style="margin-top: 2.75rem; max-width: 46rem;">
        <h2 class="h3">{data.whyChoose.closingHeading}</h2>
        <div class="prose" style="margin-top: 1rem;">
          {data.whyChoose.closingParagraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div style="margin-top: 1.5rem;">
          <Button href="/get-a-quote" size="lg" arrow>Book a free consultation</Button>
        </div>
      </div>
    )
  }
</Section>

<Section tone="warm" eyebrow="Questions" index="06" heading="Frequently asked questions">
  <Accordion items={data.faqs} />
</Section>

<Section tone="contrast" eyebrow="Nearby" index="07" heading="More Niagara locations">
  <ul class="chip-list">
    {
      data.relatedLinks.map((link) => (
        <li>
          <a class="chip" href={link.href}>
            {link.label}
            <Icon name="arrow-right" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<CtaBand
  eyebrow="Free consultation"
  heading={`Win the ${data.city} search`}
  description="Book a free consultation and we will map what it takes to get your business found locally."
  ctaLabel="Get a free quote"
/>
