---
import Accordion from "../components/ui/Accordion.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import PricingPlans from "../components/ui/PricingPlans.astro";
import RichText from "../components/ui/RichText.astro";
import Section from "../components/ui/Section.astro";
import { seoPricingPlans } from "../lib/pricing";

interface LocalSeoPageData {
  city: string;
  eyebrow?: string;
  hero: { title: string; description: string; image?: string; alt?: string };
  marketIntro: { heading: string; paragraphs: string[] };
  proof: {
    heading: string;
    client: string;
    label: string;
    image?: string;
    alt?: string;
    quote?: string;
    person?: string;
    items?: string[];
  };
  whyNeeded: { heading: string; paragraphs: string[]; checklist: string[] };
  services: {
    heading: string;
    subhead: string;
    cards: Array<{ title: string; paragraphs: string[] }>;
  };
  whyChoose: {
    heading: string;
    paragraphs: string[];
    awards?: { image: string; alt: string };
    blocks: Array<{
      title: string;
      paragraphs: string[];
      checklist?: string[];
      paragraphsAfter?: string[];
    }>;
    closingHeading?: string;
    closingParagraphs?: string[];
  };
  faqs: Array<{ q: string; a: string }>;
  relatedLinks: Array<{ href: string; label: string }>;
  relatedHeading?: string;
  relatedDescription?: string;
  aiSearch?: {
    heading: string;
    subhead?: string;
    paragraphs: string[];
    checklist?: string[];
  };
  coverage?: {
    heading: string;
    paragraphs?: string[];
    groups: Array<{
      heading: string;
      links: Array<{ href: string; label: string }>;
    }>;
  };
  ctaHeading?: string;
  ctaDescription?: string;
}

interface Props {
  data: LocalSeoPageData;
}

const { data } = Astro.props;
---

<PageHero
  title={data.hero.title}
  description={data.hero.description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "SEO", href: "/seo" },
    { name: data.city },
  ]}
  eyebrow={data.eyebrow ?? "Local SEO"}
  ctaLabel="Get a Free Quote"
>
  <Fragment slot="aside">
    <h2>Start with a free quote</h2>
    <p>
      Tell us about your business and we will review how you appear in local
      search, the map pack and AI answers, then send a written quote.
    </p>
    <ul class="page-hero__aside-list">
      <li><Icon name="check" /> Google Business Profile check</li>
      <li><Icon name="check" /> Local competitor scan</li>
      <li><Icon name="check" /> Written, no-obligation quote</li>
    </ul>
    <Button href="/get-a-quote" variant="gold" block arrow>Get a Free Quote</Button>
  </Fragment>
</PageHero>

<Section>
  <div class="split">
    <div class="reveal">
      <p class="eyebrow"><span class="eyebrow__index">01</span> The local market</p>
      <h2 class="h2" style="margin-top: 1rem;">{data.marketIntro.heading}</h2>
      <div class="prose" style="margin-top: 1.25rem;">
        {data.marketIntro.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
      </div>
    </div>
    {
      data.hero.image && (
        <figure class="media-frame reveal">
          <img
            src={data.hero.image}
            alt={data.hero.alt ?? `${data.city} local SEO`}
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }
  </div>
</Section>

<Section tone="contrast" eyebrow="Recent project" index="02" heading={data.proof.heading}>
  <div class="split split--top">
    <div class="reveal">
      <span class="badge">{data.proof.label}</span>
      <h3 class="h3" style="margin-top: 1rem; color: #ffffff;">{data.proof.client}</h3>
      {
        data.proof.quote && (
          <p class="prose" style="margin-top: 1.1rem; color: var(--color-contrast-muted);">
            &ldquo;<RichText text={data.proof.quote} />&rdquo;
          </p>
        )
      }
      {
        data.proof.person && (
          <p class="card__meta" style="margin-top: 0.65rem;">{data.proof.person}</p>
        )
      }
      {
        data.proof.items && data.proof.items.length > 0 && (
          <ul class="check-list" style="margin-top: 1.1rem;">
            {data.proof.items.map((item) => <li>{item}</li>)}
          </ul>
        )
      }
      <div style="margin-top: 1.75rem;">
        <Button href="/get-a-quote" variant="gold" arrow>Discuss a similar project</Button>
      </div>
    </div>
    {
      data.proof.image && (
        <figure class="media-frame reveal">
          <img
            src={data.proof.image}
            alt={data.proof.alt ?? `${data.proof.client} SEO results`}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
  </div>
</Section>

<Section>
  <div class="split split--top">
    <div class="reveal">
      <p class="eyebrow"><span class="eyebrow__index">03</span> Why it matters</p>
      <h2 class="h2" style="margin-top: 1rem;">{data.whyNeeded.heading}</h2>
      <div class="prose" style="margin-top: 1.25rem;">
        {data.whyNeeded.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
      </div>
    </div>
    <div class="callout reveal">
      <h3>What the work covers</h3>
      <ul class="check-list" style="margin-top: 1rem;">
        {data.whyNeeded.checklist.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</Section>

<Section
  tone="tint"
  eyebrow="Services"
  index="04"
  heading={data.services.heading}
  description={data.services.subhead}
>
  <div class="grid grid--3 reveal-group">
    {
      data.services.cards.map((card, index) => (
        <Card>
          <span class="service-card__number">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="card__title">{card.title}</h3>
          {card.paragraphs.map((paragraph) => <p class="card__text"><RichText text={paragraph} /></p>)}
        </Card>
      ))
    }
  </div>
</Section>

{
  data.aiSearch && (
    <Section
      tone="contrast"
      eyebrow="AI search"
      heading={data.aiSearch.heading}
      description={data.aiSearch.subhead}
    >
      <div class="split split--top">
        <div class="prose reveal">
          {data.aiSearch.paragraphs.map((paragraph) => (
            <p><RichText text={paragraph} /></p>
          ))}
        </div>
        {data.aiSearch.checklist && data.aiSearch.checklist.length > 0 && (
          <aside class="callout reveal">
            <h3>What the work covers</h3>
            <ul class="check-list" style="margin-top: 1rem;">
              {data.aiSearch.checklist.map((item) => <li>{item}</li>)}
            </ul>
          </aside>
        )}
      </div>
    </Section>
  )
}

<Section eyebrow="Why Infused" index="05" heading={data.whyChoose.heading}>
  <div class="split split--top">
    <div class="reveal">
      <div class="prose">
        {data.whyChoose.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
      </div>
      {
        data.whyChoose.awards && (
          <div class="card" style="max-width: 30rem; margin-top: 1.75rem; padding: 1.25rem;">
            <img
              src={data.whyChoose.awards.image}
              alt={data.whyChoose.awards.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }
    </div>
    <div class="grid grid--2" style="grid-template-columns: 1fr;">
      {
        data.whyChoose.blocks.map((block) => (
          <Card class="reveal">
            <h3 class="card__title" style="margin-top: 0;">{block.title}</h3>
            {block.paragraphs.map((paragraph) => <p class="card__text"><RichText text={paragraph} /></p>)}
            {block.checklist && (
              <ul class="check-list" style="margin-top: 1rem;">
                {block.checklist.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {block.paragraphsAfter?.map((paragraph) => <p class="card__text"><RichText text={paragraph} /></p>)}
          </Card>
        ))
      }
    </div>
  </div>

  {
    data.whyChoose.closingHeading && (
      <div class="reveal" style="margin-top: 2.75rem; max-width: 46rem;">
        <h2 class="h3">{data.whyChoose.closingHeading}</h2>
        <div class="prose" style="margin-top: 1rem;">
          {data.whyChoose.closingParagraphs?.map((paragraph) => <p><RichText text={paragraph} /></p>)}
        </div>
        <div style="margin-top: 1.5rem;">
          <Button href="/get-a-quote" size="lg" arrow>Get a Free Quote</Button>
        </div>
      </div>
    )
  }
</Section>

{
  data.coverage && (
    <Section
      tone="tint"
      eyebrow="Communities"
      heading={data.coverage.heading}
    >
      {data.coverage.paragraphs && data.coverage.paragraphs.length > 0 && (
        <div class="prose reveal" style="max-width: 52rem;">
          {data.coverage.paragraphs.map((paragraph) => (
            <p><RichText text={paragraph} /></p>
          ))}
        </div>
      )}
      <div class="grid grid--2 reveal-group" style="margin-top: 2rem;">
        {data.coverage.groups.map((group) => (
          <div>
            <h3 class="h3">{group.heading}</h3>
            <ul class="chip-list" style="margin-top: 1rem;">
              {group.links.map((link) => (
                <li>
                  <a class="chip" href={link.href}>
                    {link.label}
                    <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>
  )
}

<PricingPlans
  id="seo-pricing"
  eyebrow="Pricing"
  index=""
  heading={seoPricingPlans.heading}
  description={seoPricingPlans.description}
  note={seoPricingPlans.note}
  plans={seoPricingPlans.plans}
  ctaLabel="Get a Free Quote"
/>

<Section tone="warm" eyebrow="Questions" index="06" heading="Frequently asked questions">
  <Accordion items={data.faqs} />
</Section>

<Section
  tone="contrast"
  eyebrow="Related"
  index="07"
  heading={data.relatedHeading ?? "Nearby locations and search services"}
  description={data.relatedDescription}
>
  <ul class="chip-list">
    {
      data.relatedLinks.map((link) => (
        <li>
          <a class="chip" href={link.href}>
            {link.label}
            <Icon name="arrow-right" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<CtaBand
  eyebrow="Free quote"
  heading={data.ctaHeading ?? `Win the ${data.city} search`}
  description={data.ctaDescription ?? "Request a free quote and we will map what it takes to get your business found locally."}
  ctaLabel="Get a Free Quote"
/>
