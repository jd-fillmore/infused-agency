{
  "name": "infused-agency",
  "private": true,
  "description": "Infused Agency website — Astro static site",
  "version": "1.0.0",
  "license": "0BSD",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --root astro",
    "dev:astro": "astro dev --root astro",
    "build": "astro build --root astro",
    "build:astro": "astro build --root astro",
    "preview": "astro preview --root astro",
    "preview:astro": "astro preview --root astro",
    "check:astro": "astro check --root astro",
    "validate:astro": "node astro/scripts/validate-prototype.mjs",
    "verify:astro": "yarn check:astro && yarn build:astro && yarn validate:astro",
    "deploy:check": "node scripts/should-deploy-today.js",
    "format": "prettier --write \"astro/**/*.{ts,mjs,css,json,md}\" \"data/**/*.json\" \"posts/**/*.md\""
  },
  "dependencies": {
    "astro": "^5.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^11.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "^1.7.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
